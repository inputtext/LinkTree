NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-side ONLY. Use the new sb_secret_ key if available.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback (do not set both): SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables hashed anonymous unique-visitor aggregation (never expose publicly).
ANALYTICS_HASH_KEY=
# Optional: Cloudflare Turnstile bot protection on public forms.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
